<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#202020</Color>
    <Color x:Key="SurfaceColor">#2B2B2B</Color>
    <Color x:Key="SurfaceSecondaryColor">#252525</Color>
    <Color x:Key="ControlFillColor">#323232</Color>
    <Color x:Key="ControlFillHoverColor">#3A3A3A</Color>
    <Color x:Key="ControlFillPressedColor">#454545</Color>
    <Color x:Key="BorderColor">#3B3B3B</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#C8C8C8</Color>
    <Color x:Key="TextDisabledColor">#8A8A8A</Color>
    <Color x:Key="AccentColor">#479EF5</Color>
    <Color x:Key="AccentHoverColor">#62ABF5</Color>
    <Color x:Key="AccentPressedColor">#2886DE</Color>
    <Color x:Key="AccentSubtleColor">#263D52</Color>
    <Color x:Key="AccentSubtleHoverColor">#304B64</Color>
    <Color x:Key="LegacySearchAccentColor">#D76FAF</Color>
    <Color x:Key="LegacySearchAccentHoverColor">#E184BD</Color>
    <Color x:Key="LegacySearchAccentPressedColor">#C4589A</Color>
    <Color x:Key="LegacySearchAccentSubtleColor">#4B273E</Color>
    <Color x:Key="LegacySearchAccentSubtleHoverColor">#60314F</Color>
    <Color x:Key="SuccessColor">#54B054</Color>
    <Color x:Key="WarningColor">#FF9A45</Color>
    <Color x:Key="ErrorColor">#FF6B6B</Color>
    <Color x:Key="DangerColor">#E05C5C</Color>
    <Color x:Key="DangerHoverColor">#EC7474</Color>
    <Color x:Key="DangerPressedColor">#C94C4C</Color>
    <Color x:Key="DangerSubtleColor">#4A2525</Color>
    <Color x:Key="DangerSubtleHoverColor">#5B2C2C</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColor}" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="{StaticResource ControlFillHoverColor}" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="{StaticResource ControlFillPressedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="AccentSubtleHoverBrush" Color="{StaticResource AccentSubtleHoverColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LegacySearchAccentBrush" Color="{StaticResource LegacySearchAccentColor}" />
    <SolidColorBrush x:Key="LegacySearchAccentHoverBrush" Color="{StaticResource LegacySearchAccentHoverColor}" />
    <SolidColorBrush x:Key="LegacySearchAccentPressedBrush" Color="{StaticResource LegacySearchAccentPressedColor}" />
    <SolidColorBrush x:Key="LegacySearchAccentSubtleBrush" Color="{StaticResource LegacySearchAccentSubtleColor}" />
    <SolidColorBrush x:Key="LegacySearchAccentSubtleHoverBrush" Color="{StaticResource LegacySearchAccentSubtleHoverColor}" />
    <SolidColorBrush x:Key="LegacySearchAccentForegroundBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DangerPressedColor}" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource DangerSubtleColor}" />
    <SolidColorBrush x:Key="DangerSubtleHoverBrush" Color="{StaticResource DangerSubtleHoverColor}" />
    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#262626" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#D9202020" />
    <Color x:Key="ScrollThumbColor">#CC555555</Color>
    <Color x:Key="ScrollThumbHoverColor">#E66E6E6E</Color>
    <Color x:Key="ScrollThumbPressedColor">#FFAAAAAA</Color>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#00000000" />

    <SolidColorBrush x:Key="ReaderPanelBackgroundBrush" Color="#232323" />
    <SolidColorBrush x:Key="ReaderPanelBorderBrush" Color="#403F3F3F" />
    <SolidColorBrush x:Key="ReaderScrollRailBrush" Color="#181818" />
    <SolidColorBrush x:Key="ReaderForegroundBrush" Color="#E7E9EC" />
    <SolidColorBrush x:Key="CatalogPanelBackgroundBrush" Color="#F51C1C1C" />
    <SolidColorBrush x:Key="CatalogPanelBorderBrush" Color="#664A4A4A" />
    <SolidColorBrush x:Key="CatalogItemHoverBrush" Color="#383838" />
    <SolidColorBrush x:Key="CatalogItemSelectedBrush" Color="#3A263D52" />
    <SolidColorBrush x:Key="TransparentHitTestBrush" Color="#01000000" />
</ResourceDictionary>
