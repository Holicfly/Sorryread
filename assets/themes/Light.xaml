<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppBackgroundColor">#FAFAFA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceSecondaryColor">#F5F5F5</Color>
    <Color x:Key="ControlFillColor">#FFFFFF</Color>
    <Color x:Key="ControlFillHoverColor">#F5F5F5</Color>
    <Color x:Key="ControlFillPressedColor">#EBEBEB</Color>
    <Color x:Key="BorderColor">#E1E1E1</Color>
    <Color x:Key="TextPrimaryColor">#1B1B1B</Color>
    <Color x:Key="TextSecondaryColor">#5E5E5E</Color>
    <Color x:Key="TextDisabledColor">#9E9E9E</Color>
    <Color x:Key="AccentColor">#0F6CBD</Color>
    <Color x:Key="AccentHoverColor">#1978D4</Color>
    <Color x:Key="AccentPressedColor">#115EA3</Color>
    <Color x:Key="AccentSubtleColor">#E8F2FB</Color>
    <Color x:Key="AccentSubtleHoverColor">#D8EAF8</Color>
    <Color x:Key="LegacySearchAccentColor">#9D326F</Color>
    <Color x:Key="LegacySearchAccentHoverColor">#AE3F7D</Color>
    <Color x:Key="LegacySearchAccentPressedColor">#7F275A</Color>
    <Color x:Key="LegacySearchAccentSubtleColor">#F7E7F0</Color>
    <Color x:Key="LegacySearchAccentSubtleHoverColor">#EED3E2</Color>
    <Color x:Key="SuccessColor">#107C10</Color>
    <Color x:Key="WarningColor">#F7630C</Color>
    <Color x:Key="ErrorColor">#C50F1F</Color>
    <Color x:Key="DangerColor">#D9534F</Color>
    <Color x:Key="DangerHoverColor">#C94440</Color>
    <Color x:Key="DangerPressedColor">#B63B37</Color>
    <Color x:Key="DangerSubtleColor">#FCE9E8</Color>
    <Color x:Key="DangerSubtleHoverColor">#F8D4D2</Color>
    <Color x:Key="DialogShadowColor">#000000</Color>
    <SolidColorBrush x:Key="SearchOverlayShadeBrush" Color="#8C000000" />
    <Color x:Key="ColorPickerLightColor">#FFFFFF</Color>
    <Color x:Key="ColorPickerDarkColor">#000000</Color>
    <Color x:Key="ColorPickerTransparentLightColor">#00FFFFFF</Color>
    <Color x:Key="ColorPickerTransparentDarkColor">#00000000</Color>
    <Color x:Key="ColorPickerHueRedColor">#FF0000</Color>
    <Color x:Key="ColorPickerHueYellowColor">#FFFF00</Color>
    <Color x:Key="ColorPickerHueGreenColor">#00FF00</Color>
    <Color x:Key="ColorPickerHueCyanColor">#00FFFF</Color>
    <Color x:Key="ColorPickerHueBlueColor">#0000FF</Color>
    <Color x:Key="ColorPickerHueMagentaColor">#FF00FF</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColor}" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="{StaticResource ControlFillHoverColor}" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="{StaticResource ControlFillPressedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="AccentSubtleHoverBrush" Color="{StaticResource AccentSubtleHoverColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LegacySearchAccentBrush" Color="{StaticResource LegacySearchAccentColor}" />
    <SolidColorBrush x:Key="LegacySearchAccentHoverBrush" Color="{StaticResource LegacySearchAccentHoverColor}" />
    <SolidColorBrush x:Key="LegacySearchAccentPressedBrush" Color="{StaticResource LegacySearchAccentPressedColor}" />
    <SolidColorBrush x:Key="LegacySearchAccentSubtleBrush" Color="{StaticResource LegacySearchAccentSubtleColor}" />
    <SolidColorBrush x:Key="LegacySearchAccentSubtleHoverBrush" Color="{StaticResource LegacySearchAccentSubtleHoverColor}" />
