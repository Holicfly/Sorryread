<Window x:Class="ReadAI.TransparentReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="素若阅读"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="TransparentWindowPreviewKeyDown"
        PreviewKeyUp="TransparentWindowPreviewKeyUp"
        PreviewMouseLeftButtonDown="TransparentWindowPreviewMouseLeftButtonDown"
        PreviewMouseWheel="TransparentWindowPreviewMouseWheel"
        Closing="TransparentWindowClosing">
    <Grid>
        <Canvas x:Name="TransparentCanvas" Background="{DynamicResource TransparentHitTestBrush}">
            <RichTextBox x:Name="TransparentReaderBox"
                     IsReadOnly="True"
                     IsDocumentEnabled="False"
                     ContextMenu="{StaticResource ReaderCopyContextMenu}"
                     BorderThickness="0"
                     Background="{DynamicResource TransparentHitTestBrush}"
                     VerticalScrollBarVisibility="Hidden"
                     HorizontalScrollBarVisibility="Hidden"
                     Padding="0"
                     Focusable="True"
                     ScrollViewer.ScrollChanged="ReaderScrollChanged" />
        </Canvas>
        <Border x:Name="ChapterPositionHint" Visibility="Collapsed" Opacity="0"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False" CornerRadius="23" Padding="16,10"
                Background="{DynamicResource OverlayBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35"
                                  Color="{DynamicResource DialogShadowColor}" />
            </Border.Effect>
            <TextBlock x:Name="ChapterPositionText" FontSize="14"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       TextAlignment="Center" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
