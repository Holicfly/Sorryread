<Window x:Class="ReadAI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史记录"
        Width="920"
        Height="480"
        MinWidth="640"
        MinHeight="280"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <ListBox x:Name="HistoryList"
                     Padding="0,0,2,0"
                     AlternationCount="1000"
                     SelectionMode="Single"
                     MouseDoubleClick="HistoryListMouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource CardListBoxItemStyle}">
                        <EventSetter Event="Loaded" Handler="HistoryItemLoaded" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,2,14,2"
                                       VerticalAlignment="Top"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Text="{Binding Title}"
                                       TextWrapping="Wrap" />
                            <Border Grid.Column="1"
                                    Margin="0,0,14,0"
                                    Background="{DynamicResource BorderBrush}" />
                            <StackPanel Grid.Column="2" Margin="0,2,0,2">
                                <TextBlock Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           Text="{Binding Url}"
                                           TextWrapping="Wrap" />
                                <WrapPanel Margin="0,6,0,0">
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="首次解析：" />
                                    <TextBlock Text="{Binding FirstParsedText}" Margin="0,0,16,0" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="上次解析：" />
                                    <TextBlock Text="{Binding LastParsedText}" Margin="0,0,16,0" />
                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Text="解析次数：" />
                                    <TextBlock Text="{Binding ParseCountText}" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Style>
                    <Style TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems, ElementName=HistoryList}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="28"
                               Foreground="{DynamicResource AccentBrush}"
                               Text="◇" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="暂无历史记录" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="12,10"
                Style="{StaticResource CardStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ClearHistoryButton"
                            Content="清空历史记录"
                            MinWidth="112"
                            Margin="0,0,8,0"
                            Click="ClearHistoryClick" />
                    <Button Content="复制网址" MinWidth="88" Margin="0,0,8,0" Click="CopyUrlClick" />
                    <Button Content="删除" MinWidth="72" Margin="0,0,8,0" Click="DeleteClick" />
                    <Button Content="关闭" MinWidth="72" IsCancel="True" />
                </StackPanel>
                <TextBlock x:Name="HintText"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="双击记录可继续阅读"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
