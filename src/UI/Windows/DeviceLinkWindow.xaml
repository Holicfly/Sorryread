<Window x:Class="ReadAI.DeviceLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="设备互联" Width="400" Height="272" MinWidth="380" MinHeight="260"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="WindowPreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="LinkActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource ControlFillPressedBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Danger" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <!-- Keep state brushes in the theme dictionary. Mixing a local
                                     static brush with dynamic state setters caused UnsetValue on release. -->
                                <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource DangerSubtleHoverBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkDangerButton" TargetType="Button" BasedOn="{StaticResource LinkActionButton}">
            <Setter Property="Tag" Value="Danger" />
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource LinkActionButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
    </Window.Resources>
    <Border x:Name="WindowFrame" Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" CornerRadius="11,11,0,0">
                <Grid Margin="12,0,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Image x:Name="HeaderIcon" Width="18" Height="18" Margin="0,0,8,0" />
                        <TextBlock Text="设备互联" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource CaptionButton}" ToolTip="最小化" AutomationProperties.Name="最小化"
                                Click="MinimizeClick">
                            <Path Data="M 0,5 L 13,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" Width="14" Height="12" />
                        </Button>
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" ToolTip="最大化"
                                AutomationProperties.Name="最大化或还原" Click="MaximizeClick">
                            <Path Data="M 1,1 L 12,1 L 12,12 L 1,12 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.4" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" ToolTip="关闭" AutomationProperties.Name="关闭"
                                Click="CloseClick">
                            <Path Data="M 1,1 L 13,13 M 13,1 L 1,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.6" Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel Margin="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="QrColumn" VerticalAlignment="Top">
                            <Grid x:Name="QrHost" Width="174" Height="174">
                                <Border x:Name="QrShadow" Background="#000000" CornerRadius="12"
                                        Visibility="{Binding Visibility, ElementName=QrCard}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                                          Opacity="0.16" Color="#000000" />
                                    </Border.Effect>
                                </Border>
                                <Border x:Name="QrCard" Background="White" CornerRadius="12" Padding="5"
                                        BorderBrush="#E4E4E7" BorderThickness="1">
                                    <Grid>
                                        <Border x:Name="QrBackground" Background="White" CornerRadius="8"
                                                ClipToBounds="True" Visibility="Collapsed">
                                            <Image x:Name="QrImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                   AutomationProperties.Name="手机配对二维码" />
                                        </Border>
                                        <TextBlock x:Name="QrHintText" Text="正在生成配对二维码…" TextWrapping="Wrap"
                                                   TextAlignment="Center" VerticalAlignment="Center" Margin="14"
                                                   Foreground="#5E5E5E" FontSize="12" />
                                    </Grid>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="QrCountdownText" Margin="0,6,0,0" FontSize="11.5"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel x:Name="StatusPanel" Grid.Column="1" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" StrokeThickness="2" Margin="0,0,8,0"
                                         Stroke="{DynamicResource ErrorBrush}" />
                                <TextBlock x:Name="StatusText" Text="未连接" FontSize="20" FontWeight="Bold"
                                           VerticalAlignment="Center" Foreground="{DynamicResource ErrorBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="DescriptionText" Margin="0,6,0,9" FontSize="11.5" LineHeight="17"
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            <Border x:Name="DeviceCard" Padding="8" Margin="0,0,0,8" CornerRadius="8" Visibility="Collapsed"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="26" Height="36" CornerRadius="7" BorderThickness="1"
                                            BorderBrush="{DynamicResource BorderBrush}" VerticalAlignment="Center">
                                        <Viewbox Width="13" Height="22">
                                            <Canvas Width="22" Height="32">
                                                <Path Data="M 5,1 L 17,1 Q 20,1 20,4 L 20,28 Q 20,31 17,31 L 5,31 Q 2,31 2,28 L 2,4 Q 2,1 5,1 Z"
                                                      Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" />
                                                <Ellipse Canvas.Left="9.5" Canvas.Top="25" Width="3" Height="3"
                                                         Fill="{DynamicResource TextPrimaryBrush}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="DeviceNameText" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="如需切换设备，请先解除当前配对。" Margin="0,4,0,0" FontSize="11"
                                                   LineHeight="16" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Button x:Name="RefreshButton" Margin="0,0,0,5"
                                    Style="{StaticResource LinkActionButton}" Click="RefreshClick">
                                <TextBlock Text="刷新配对二维码" TextWrapping="Wrap" TextAlignment="Center" />
                            </Button>
                            <Button x:Name="ForgetButton" Margin="0,0,0,5" Visibility="Collapsed"
                                    Style="{StaticResource LinkDangerButton}" Click="ForgetClick">
                                <TextBlock Text="解除当前配对" TextWrapping="Wrap" TextAlignment="Center" />
                            </Button>
                            <Button x:Name="RecordsButton" Style="{StaticResource LinkActionButton}" Click="RecordsClick">
                                <TextBlock Text="查看同步记录与进度冲突" TextWrapping="Wrap" TextAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ErrorText" Margin="0,10,0,0" FontSize="11" LineHeight="16" Visibility="Collapsed"
                               TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
                    <Border x:Name="DetailsCard" Margin="0,12,0,0" Padding="10" CornerRadius="8" Visibility="Collapsed"
                            Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel x:Name="DetailsPanel" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
