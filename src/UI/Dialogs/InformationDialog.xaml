<Window x:Class="ReadAI.InformationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="素若阅读"
        Width="430"
        Height="350"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}"
        PreviewKeyDown="DialogPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="KeyCapStyle" TargetType="{x:Type Border}">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
    </Window.Resources>

    <Border Margin="12"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Color="#99000000"
                              Opacity="0.4"
                              ShadowDepth="3" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="16,10"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    MouseLeftButtonDown="HeaderMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="DialogTitleText"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="DialogSubtitleText"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="28"
                            Height="28"
                            MinWidth="28"
                            MinHeight="28"
                            Margin="12,0,0,0"
                            Padding="0"
                            Content="×"
                            FontSize="17"
                            ToolTip="关闭"
                            Click="CloseClick" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />

            <Grid Grid.Row="2" Margin="18,12">
                <ItemsControl x:Name="GuideItemsControl"
                              VerticalAlignment="Center"
                              Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,4"
                                    Padding="10,6"
                                    Background="{DynamicResource SurfaceSecondaryBrush}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3"
                                            Margin="0,2,9,2"
                                            Background="{DynamicResource AccentBrush}"
                                            CornerRadius="2" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Title}" />
                                    <TextBlock Grid.Column="2"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding Text}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ScrollViewer x:Name="ShortcutScrollViewer"
                              Padding="0,0,7,0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              PanningMode="VerticalOnly"
                              Visibility="Collapsed">
                    <ItemsControl x:Name="ShortcutItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6"
                                        Padding="9,6"
                                        Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource KeyCapStyle}">
                                            <TextBlock HorizontalAlignment="Center"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Text="{Binding Keys}" />
                                        </Border>
                                        <StackPanel Grid.Column="1"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Text="{Binding Action}" />
                                            <TextBlock Margin="0,1,0,0"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Text="{Binding Scope}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="AboutPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="素若阅读" />
                    <TextBlock x:Name="VersionText"
                               Margin="0,3,0,0"
                               HorizontalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource TextDisabledBrush}" />
                    <Border Margin="0,16,0,0"
                            Padding="18,10"
                            Background="{DynamicResource SurfaceSecondaryBrush}"
                            CornerRadius="7">
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Text="多书源聚合搜索与通用正文提取" />
                            <TextBlock Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="解析记录、书库收藏与透明阅读" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3"
                    Padding="14,8"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Button x:Name="DetailedUsageButton"
                            Visibility="Collapsed"
                            MinHeight="28" Padding="12,4" FontSize="12"
                            HorizontalAlignment="Left"
                            Content="阅读详细说明"
                            ToolTip="用系统默认 TXT 阅读器打开完整操作说明"
                            Click="DetailedUsageButtonClick" />
                    <Button x:Name="GithubButton" Visibility="Collapsed" HorizontalAlignment="Left"
                            ToolTip="访问 GitHub 项目主页" Click="GithubClick" Cursor="Hand"
                            MinHeight="28" Padding="4,2" FontSize="11"
                            Foreground="{DynamicResource TextSecondaryBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="18" Height="18" Margin="0,0,6,0"
                                       Fill="{Binding Foreground, ElementName=GithubButton}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="pack://application:,,,/assets/images/Github.png" Stretch="Uniform" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="GitHub 主页" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CloseButton"
                        MinWidth="72"
                        MinHeight="28"
                        Padding="14,4"
                        HorizontalAlignment="Right"
                        Content="关闭"
                        Style="{StaticResource AccentButtonStyle}"
                        IsCancel="True"
                        Click="CloseClick" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
