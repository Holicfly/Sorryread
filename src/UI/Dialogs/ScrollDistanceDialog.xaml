<Window x:Class="ReadAI.ScrollDistanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="滚动距离调整" Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Margin="12" Padding="20" CornerRadius="11"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="滚动距离调整" FontSize="17" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="每次按上下方向键滚动的行数（1–10）"
                       Margin="0,12,0,8" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBox x:Name="LinesInput" AutomationProperties.Name="滚动行数"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     Background="{DynamicResource AppBackgroundBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" />
            <TextBlock x:Name="ErrorText" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="Collapsed" Foreground="{DynamicResource WarningBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="确定" MinWidth="72" IsDefault="True" Click="ConfirmClick" />
                <Button Content="取消" MinWidth="72" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
