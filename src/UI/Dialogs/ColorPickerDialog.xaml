<Window x:Class="ReadAI.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义文字颜色"
        Width="460"
        Height="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        PreviewKeyDown="DialogPreviewKeyDown"
        Loaded="DialogLoaded">
    <Window.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="PresetSwatchStyle" TargetType="{x:Type Button}">
            <Setter Property="Width" Value="54" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="SwatchBorder"
                                    Margin="2"
                                    Background="{Binding Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6" />
                            <Border x:Name="SelectionRing"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter TargetName="SwatchBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SwatchBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="DialogRoot"
            Margin="12"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="11"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform Y="8" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              Color="{DynamicResource DialogShadowColor}"
                              Opacity="0.42"
                              ShadowDepth="4" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="16,10"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    MouseLeftButtonDown="HeaderMouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Text="自定义文字颜色" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="选择适合当前阅读环境的文字颜色" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Width="28"
                            Height="28"
                            MinWidth="28"
                            MinHeight="28"
                            Margin="12,0,0,0"
                            Padding="0"
                            AutomationProperties.Name="关闭颜色选择器"
                            Content="×"
                            FontSize="17"
                            ToolTip="关闭"
                            Click="CloseClick" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />

            <Grid Grid.Row="2" Margin="18,12,18,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="170" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource SectionLabelStyle}" Text="常用颜色" />
                <ItemsControl x:Name="PresetColorsItemsControl"
                              Grid.Row="1"
                              Margin="-4,5,-4,11">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button AutomationProperties.Name="{Binding Name}"
                                    Style="{StaticResource PresetSwatchStyle}"
                                    Tag="{Binding Hex}"
                                    ToolTip="{Binding Name}"
                                    Click="PresetColorClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2"
                           Margin="0,0,0,7"
                           Style="{StaticResource SectionLabelStyle}"
                           Text="精确取色" />

                <Border Grid.Row="3"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid x:Name="SaturationValuePanel"
                          ClipToBounds="True"
                          Cursor="Cross"
                          AutomationProperties.Name="饱和度与亮度取色区域"
                          MouseLeftButtonDown="SaturationValueMouseLeftButtonDown"
                          MouseLeftButtonUp="SaturationValueMouseLeftButtonUp"
                          MouseMove="SaturationValueMouseMove"
                          LostMouseCapture="SaturationValueLostMouseCapture">
                        <Border x:Name="HueBaseBorder" />
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Offset="0" Color="{DynamicResource ColorPickerLightColor}" />
                                    <GradientStop Offset="1" Color="{DynamicResource ColorPickerTransparentLightColor}" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Offset="0" Color="{DynamicResource ColorPickerTransparentDarkColor}" />
                                    <GradientStop Offset="1" Color="{DynamicResource ColorPickerDarkColor}" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas Background="Transparent" IsHitTestVisible="False">
                            <Grid x:Name="SaturationValueCursor" Width="18" Height="18">
                                <Ellipse Stroke="{DynamicResource AppBackgroundBrush}" StrokeThickness="4" />
                                <Ellipse Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="2" />
                            </Grid>
                        </Canvas>
                    </Grid>
                </Border>

                <Grid x:Name="HuePanel"
                      Grid.Row="4"
                      Height="22"
                      Margin="0,10,0,0"
                      ClipToBounds="True"
                      Cursor="Hand"
                      AutomationProperties.Name="色相选择条"
                      MouseLeftButtonDown="HueMouseLeftButtonDown"
                      MouseLeftButtonUp="HueMouseLeftButtonUp"
                      MouseMove="HueMouseMove"
                      LostMouseCapture="HueLostMouseCapture">
                    <Border Margin="0,3"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Offset="0" Color="{DynamicResource ColorPickerHueRedColor}" />
                                <GradientStop Offset="0.167" Color="{DynamicResource ColorPickerHueYellowColor}" />
                                <GradientStop Offset="0.333" Color="{DynamicResource ColorPickerHueGreenColor}" />
                                <GradientStop Offset="0.5" Color="{DynamicResource ColorPickerHueCyanColor}" />
                                <GradientStop Offset="0.667" Color="{DynamicResource ColorPickerHueBlueColor}" />
                                <GradientStop Offset="0.833" Color="{DynamicResource ColorPickerHueMagentaColor}" />
                                <GradientStop Offset="1" Color="{DynamicResource ColorPickerHueRedColor}" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Canvas Background="Transparent" IsHitTestVisible="False">
                        <Border x:Name="HueCursor"
                                Width="10"
                                Height="22"
                                Background="Transparent"
                                BorderBrush="{DynamicResource AppBackgroundBrush}"
                                BorderThickness="3"
                                CornerRadius="5">
                            <Border BorderBrush="{DynamicResource TextPrimaryBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3" />
                        </Border>
                    </Canvas>
                </Grid>

                <Grid Grid.Row="5" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SelectedColorPreview"
                            Width="52"
                            Height="40"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7"
                            ToolTip="当前颜色" />
                    <TextBlock Grid.Column="1"
                               Margin="12,0,9,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Hex" />
                    <TextBox x:Name="HexTextBox"
                             Grid.Column="2"
                             Height="36"
                             VerticalContentAlignment="Center"
                             AutomationProperties.Name="Hex 颜色值"
                             FontFamily="Consolas"
                             FontSize="13"
                             MaxLength="7"
                             TextChanged="HexTextChanged"
                             LostKeyboardFocus="HexTextBoxLostKeyboardFocus" />
                </Grid>

                <TextBlock x:Name="ValidationText"
                           Grid.Row="6"
                           Height="18"
                           Margin="64,3,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource ErrorBrush}"
                           Text="请输入 #RRGGBB 格式的颜色值"
                           Visibility="Hidden" />
            </Grid>

            <Border Grid.Row="3"
                    Padding="14,9"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="CancelButton"
                            MinWidth="78"
                            Content="取消"
                            IsCancel="True"
                            Click="CancelClick" />
                    <Button x:Name="ConfirmButton"
                            MinWidth="78"
                            Margin="8,0,0,0"
                            AutomationProperties.Name="确定选择颜色"
                            Content="确定"
                            IsDefault="True"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="ConfirmClick" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
