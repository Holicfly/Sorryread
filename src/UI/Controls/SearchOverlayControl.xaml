<UserControl x:Class="ReadAI.SearchOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" Opacity="0"
             KeyboardNavigation.TabNavigation="Cycle"
             PreviewKeyDown="OverlayPreviewKeyDown"
             Unloaded="OverlayUnloaded"
             SizeChanged="OverlaySizeChanged">
    <Grid>
        <Border x:Name="Backdrop" Background="{DynamicResource SearchOverlayShadeBrush}"
                MouseLeftButtonDown="BackdropMouseLeftButtonDown" />
        <StackPanel x:Name="SearchCard" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Height="46" Padding="12,4,6,4" CornerRadius="23"
                    Background="{DynamicResource SurfaceSecondaryBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox" VerticalContentAlignment="Center"
                             FontSize="14" Padding="0" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             SelectionBrush="{DynamicResource AccentSubtleHoverBrush}"
                             Background="Transparent"
                             AutomationProperties.Name="搜索小说关键词"
                             ToolTip="输入书名、作者或关键词，按 Enter 搜索">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                    <Button x:Name="SubmitButton" Grid.Column="1" Width="30" Height="30"
                            MinWidth="30" MinHeight="30" Margin="6,0,0,0" Padding="5"
                            Style="{StaticResource StatusChapterButtonStyle}"
                            ToolTip="开始搜索" AutomationProperties.Name="执行小说搜索"
                            Click="SubmitClick">
                        <Rectangle Width="16" Height="16" Fill="{DynamicResource AccentBrush}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://application:,,,/assets/images/搜索.png" Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                        </Rectangle>
                    </Button>
                </Grid>
            </Border>
            <Border Margin="0,8,0,0" Padding="10,3" CornerRadius="10"
                    HorizontalAlignment="Center" Background="{DynamicResource SurfaceBrush}">
                <TextBlock x:Name="ModeHintText" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
