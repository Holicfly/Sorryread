<UserControl x:Class="ReadAI.MarqueeTextBlock"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsHitTestVisible="False">
    <Grid ClipToBounds="True">
        <Canvas x:Name="TextStrip">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="TextTranslate" />
            </Canvas.RenderTransform>
        <TextBlock x:Name="TextElement"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   FontFamily="{Binding FontFamily, ElementName=Root}"
                   FontSize="{Binding FontSize, ElementName=Root}"
                   FontStyle="{Binding FontStyle, ElementName=Root}"
                   FontWeight="{Binding FontWeight, ElementName=Root}"
                   Foreground="{Binding Foreground, ElementName=Root}"
                   Text="{Binding Text, ElementName=Root}"
                   TextWrapping="NoWrap">
        </TextBlock>
        <TextBlock x:Name="TextCopy" Visibility="Collapsed"
                   FontFamily="{Binding FontFamily, ElementName=Root}"
                   FontSize="{Binding FontSize, ElementName=Root}"
                   FontStyle="{Binding FontStyle, ElementName=Root}"
                   FontWeight="{Binding FontWeight, ElementName=Root}"
                   Foreground="{Binding Foreground, ElementName=Root}"
                   Text="{Binding Text, ElementName=Root}" TextWrapping="NoWrap" />
        </Canvas>
    </Grid>
</UserControl>
