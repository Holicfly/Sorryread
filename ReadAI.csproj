<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>assets\icons\app.ico</ApplicationIcon>
    <AssemblyName>素若阅读</AssemblyName>
    <RootNamespace>ReadAI</RootNamespace>
    <AssemblyTitle>素若阅读</AssemblyTitle>
    <Product>素若阅读</Product>
    <Company>Sorryread</Company>
    <Authors>Sorryread</Authors>
    <Version>1.1.7</Version>
    <AssemblyVersion>1.1.7.0</AssemblyVersion>
    <FileVersion>1.1.7.0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Platforms>AnyCPU</Platforms>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <CopyDocumentationFilesFromPackages>false</CopyDocumentationFilesFromPackages>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.7.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\icons\app.ico">
      <Link>app.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="docs\素若阅读使用说明.txt">
      <Link>素若阅读使用说明.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Resource Include="assets\images\展开.png" />
    <Resource Include="assets\images\收起.png" />
    <Resource Include="assets\images\播放器_上一章.png" />
    <Resource Include="assets\images\播放器_下一章.png" />
    <Resource Include="assets\images\返回.png" />
    <Resource Include="assets\images\主页.png" />
    <Resource Include="assets\images\搜索.png" />
    <Resource Include="assets\images\Github.png" />
    <Resource Include="assets\images\书库.png" />
    <Resource Include="assets\images\叉号.png" />
    <Resource Include="assets\images\未收藏.png" />
    <Resource Include="assets\images\已收藏.png" />
  </ItemGroup>
</Project>
